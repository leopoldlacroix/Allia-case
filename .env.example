# OpenAI-compatible LLM — swap provider by changing these three:
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional HTTP headers (OpenRouter rankings; harmless elsewhere)
LLM_APP_URL=https://github.com/your-user/Allias-case
LLM_APP_TITLE=Allias email classifier

# Optional — same firm domain the rules method uses
FIRM_DOMAIN=accountingfirm.com

# Fail-safes (defaults shown)
# LLM_FALLBACK=1
# LLM_STRICT=0
# LLM_MAX_RETRIES=3
# LLM_RECURSION_LIMIT=3   # min ~3 for ToolStrategy (model + structured tool)
