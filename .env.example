# Required for --method llm
OPENROUTER_API_KEY=sk-or-v1-...

# Required for --method llm (use a free OpenRouter slug; no OpenAI default)
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# Optional — OpenRouter app attribution / rankings
OPENROUTER_APP_URL=https://github.com/your-user/Allias-case
OPENROUTER_APP_TITLE=Allias email classifier

# Optional — same firm domain the rules method uses
FIRM_DOMAIN=accountingfirm.com

# Fail-safes (defaults shown)
# LLM_FALLBACK=1   # set to 0 to fail fast instead of falling back to rules
# LLM_STRICT=0     # set to 1 to raise on missing key/model/deps instead of fallback
# LLM_MAX_RETRIES=3
