# OpenAI-compatible chat (default) OR TypeSafe/Jev/Tev1 decision API
LLM_API_MODE=chat
# LLM_API_MODE=systemone   # aliases: jev, tev, tev1, typesafe, decision

LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Local Ollama chat (gemma4, llama3.2, …):
# LLM_API_MODE=chat
# LLM_API_KEY=ollama
# LLM_MODEL=gemma4:e4b
# LLM_BASE_URL=http://localhost:11434/v1

# Local Ollama Tev1 decision model:
# LLM_API_MODE=systemone
# LLM_API_KEY=ollama
# LLM_MODEL=tev1
# LLM_BASE_URL=http://localhost:11434/v1
# (POSTs to …/v1/systemone automatically)

# Optional HTTP headers
LLM_APP_URL=https://github.com/your-user/Allias-case
LLM_APP_TITLE=Allias email classifier

FIRM_DOMAIN=accountingfirm.com

# LLM_FALLBACK=1
# LLM_STRICT=0
# LLM_MAX_RETRIES=3
# LLM_RECURSION_LIMIT=3
