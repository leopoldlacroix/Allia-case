# OpenAI-compatible LLM (OpenRouter is the default base URL)
LLM_API_KEY=sk-or-v1-...
LLM_MODEL=dots-studio/dots-3-note-preview:free
LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional attribution (mainly useful on OpenRouter)
LLM_APP_URL=https://github.com/your-user/Allias-case
LLM_APP_TITLE=Allias email classifier

# Legacy aliases still accepted: OPENROUTER_API_KEY, OPENROUTER_MODEL,
# OPENROUTER_APP_URL, OPENROUTER_APP_TITLE

# Optional — same firm domain the rules method uses
FIRM_DOMAIN=accountingfirm.com

# Fail-safes (defaults shown)
# LLM_FALLBACK=1   # set to 0 to fail fast instead of falling back to rules
# LLM_STRICT=0     # set to 1 to raise on missing key/model/deps instead of fallback
# LLM_MAX_RETRIES=3
# LLM_RECURSION_LIMIT=1   # max agent steps per email (one pass)
