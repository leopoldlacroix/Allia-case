# Profile for local Ollama chat — copy to .env.chat-gemma (or similar) and use:
#   python3 -m classifier.review data/sample_accountant_emails.json \
#     --method llm --env-file .env.chat-gemma --tag gemma --labels data/eval_labels.json

LLM_API_MODE=chat
LLM_API_KEY=ollama
LLM_MODEL=gemma4:e4b
LLM_BASE_URL=http://localhost:11434/v1
